{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lijianjun004-star/tcl-live-monitor/schemas/targets.schema.json",
  "title": "V2 monitoring targets (injected through the V2_TARGETS_JSON secret)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_targets": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 8},
        "per_group_max": {"type": "integer", "minimum": 1, "maximum": 7},
        "room_budget_seconds": {"type": "number", "minimum": 5, "maximum": 30},
        "inter_room_delay_seconds": {"type": "number", "minimum": 0, "maximum": 30},
        "jd_circuit_breaker": {"type": "boolean"},
        "cache_stale_hours": {"type": "number", "minimum": 1, "maximum": 720}
      }
    },
    "keywords": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 40}
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thumbnails": {"type": "boolean"},
        "notify_dedupe_hours": {"type": "number", "minimum": 0, "maximum": 168}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/target"}
    }
  },
  "$defs": {
    "public_id": {"type": "string", "pattern": "^[1-9][0-9]{4,17}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "platform", "mode"],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
        "platform": {"enum": ["jd", "tmall", "taobao"]},
        "mode": {"enum": ["direct", "shop_discover", "sku_discover", "anchor_entry", "short_link"]},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 60},
        "canary": {"type": "boolean"},
        "live_id": {"$ref": "#/$defs/public_id"},
        "short_link": {"type": "string", "maxLength": 300},
        "short_link_role": {"enum": ["clip", "control", "product"]},
        "sku_id": {"type": "string", "pattern": "^[1-9][0-9]{3,19}$"},
        "shop_id": {"type": "string", "pattern": "^[1-9][0-9]{2,15}$"},
        "vender_id": {"type": "string", "pattern": "^[1-9][0-9]{2,15}$"},
        "account_id": {"type": "string", "pattern": "^[0-9]{5,16}$"},
        "room_number": {"type": "string", "pattern": "^[0-9]{3,12}$"},
        "account_group": {"enum": [1, 2, 3]}
      },
      "allOf": [
        {
          "if": {"properties": {"platform": {"const": "jd"}}},
          "then": {
            "properties": {"mode": {"enum": ["direct", "shop_discover", "sku_discover"]}},
            "not": {"anyOf": [{"required": ["account_group"]}, {"required": ["account_id"]}, {"required": ["room_number"]}]}
          }
        },
        {
          "if": {"properties": {"platform": {"enum": ["tmall", "taobao"]}}},
          "then": {
            "properties": {"mode": {"enum": ["anchor_entry", "short_link"]}},
            "required": ["account_group", "display_name"],
            "not": {"anyOf": [{"required": ["canary"]}, {"required": ["sku_id"]}, {"required": ["shop_id"]}, {"required": ["vender_id"]}, {"required": ["live_id"]}]}
          }
        },
        {
          "if": {"properties": {"platform": {"const": "jd"}, "mode": {"const": "direct"}}, "required": ["platform", "mode"]},
          "then": {
            "oneOf": [
              {"required": ["live_id"], "not": {"required": ["short_link"]}},
              {
                "required": ["short_link", "short_link_role"],
                "not": {"required": ["live_id"]},
                "properties": {
                  "short_link": {"pattern": "^https://3\\.cn/[A-Za-z0-9_-]{1,32}$"},
                  "short_link_role": {"enum": ["clip", "control"]}
                }
              }
            ]
          }
        },
        {
          "if": {"properties": {"platform": {"const": "jd"}, "mode": {"const": "sku_discover"}}, "required": ["platform", "mode"]},
          "then": {
            "oneOf": [
              {"required": ["sku_id"], "not": {"required": ["short_link"]}},
              {
                "required": ["short_link", "short_link_role"],
                "not": {"required": ["sku_id"]},
                "properties": {
                  "short_link": {"pattern": "^https://3\\.cn/[A-Za-z0-9_-]{1,32}$"},
                  "short_link_role": {"const": "product"}
                }
              }
            ]
          }
        },
        {
          "if": {"properties": {"platform": {"const": "jd"}, "mode": {"const": "shop_discover"}}, "required": ["platform", "mode"]},
          "then": {"required": ["shop_id"], "not": {"required": ["short_link"]}}
        },
        {
          "if": {"properties": {"platform": {"enum": ["tmall", "taobao"]}, "mode": {"const": "anchor_entry"}}, "required": ["platform", "mode"]},
          "then": {"required": ["account_id"], "not": {"required": ["short_link"]}}
        },
        {
          "if": {"properties": {"platform": {"enum": ["tmall", "taobao"]}, "mode": {"const": "short_link"}}, "required": ["platform", "mode"]},
          "then": {
            "required": ["short_link"],
            "not": {"required": ["short_link_role"]},
            "properties": {"short_link": {"pattern": "^https://m\\.tb\\.cn/[A-Za-z0-9_.-]{1,64}(\\?[A-Za-z0-9_.=&%-]{0,200})?$"}}
          }
        },
        {
          "if": {"required": ["canary"], "properties": {"canary": {"const": true}}},
          "then": {"properties": {"platform": {"const": "jd"}, "mode": {"const": "direct"}}}
        }
      ]
    }
  }
}
